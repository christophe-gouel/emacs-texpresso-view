     fz_rect bb = xf->bbox;
-    if (!fz_is_infinite_rect(bb) && bb.x1 > bb.x0 && bb.y1 > bb.y0)
+    // A picture not cut fills its box, whatever resolution it gives
+    if (!fz_is_infinite_rect(bb) && bb.x1 > bb.x0 && bb.y1 > bb.y0 &&
+        !whole_picture(bb, img))
     {
